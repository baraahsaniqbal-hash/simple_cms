<% @page_title ="New Page" %>

<%= link_to("<< Back to List", pages_path(subject_id: @page.subject.id), :class => 'back-link' )%>

<div class="pages new">
    <h2>Create Page</h2>
    <%= form_for(@page, url: pages_path(subject_id: @page.subject.id)) do |f| %>
        <%= render partial: "form", locals: { f: f } %> 

        <div class = "form-buttons">
            <%= submit_tag("Create Page") %>
        </div>

    <% end %>
</div>