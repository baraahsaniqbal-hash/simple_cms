 <% @page_title ="Edit Page" %>

<%= link_to("<< Back to List", pages_path(subject_id: @page.subject.id), :class => 'back-link' )%>

<div class="pages edit">
    <h2>Edit Page</h2>
    <%= form_for(@page, url: page_path(subject_id: @page.subject.id), method: :patch) do |f| %>
        <%= render partial: "form", locals: { f: f } %> 
        <div class = "form-buttons">
            <%= submit_tag("Update Page") %>
        </div>
    <% end %>
</div>