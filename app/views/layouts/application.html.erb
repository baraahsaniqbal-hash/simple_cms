<!DOCTYPE html>
<html>
  <head>
    <%= yield :head %>
    <title>Simple Cms | <%= @page_title || "Admin" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag 'application', media: 'all', 'data-turbolinks-track': 'reload' %>
    <%= javascript_pack_tag 'application', 'data-turbolinks-track': 'reload' %>
  </head>
  <body>
    <%= render 'shared/navbar' %>
    <% if user_signed_in? %>
      <h6 class="user-status-text"> 
        User:  <strong><%= "#{current_user.first_name} #{current_user.last_name}" %>
      </h6>
    <% end %>
    <div id="main">
      <div id="flash">
        <%= render "shared/flash" %>
      </div>
      <div id="content">
        <%= yield %>
      </div>
    </div>
    <div id="footer">
        <p id="copyright">&copy; Rails.com / Brainarcs</p>
    </div>
  </body>
</html>
<script>
