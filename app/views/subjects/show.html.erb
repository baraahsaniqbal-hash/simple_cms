 <% @page_title ="Show Subject" %>

<div>
    <h2>Show Subject</h2>
    <table class ="table table-striped table-bordered">
        <tr>
            <th>Name</th>
            <th>Position</th>
            <th>Visible</th>
        </tr> 
        <tr>
            <td><%= @subject.name %></td>
            <td><%= @subject.position %></td>
            <td><%= @subject.visible ? 'true' : 'false' %></td>
        </tr> 
    </table>
</div>

<p class="text-end"><%= link_to("Back", subjects_path, :class => 'btn btn-back' )%></p>